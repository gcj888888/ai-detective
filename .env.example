# 复制为 .env 后填写。所有值都只在本地生效，不要提交到仓库。

# —— 腾讯云（元宝搜索）——
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 元宝搜索可选参数，留空即用默认
WSA_MODE=
WSA_CNT=

# —— 大模型：OpenAI 兼容接口 ——
# 可选 toklens / tokenhub / deepseek，默认 toklens
LLM_PROVIDER=toklens

TOKLENS_API_KEY=
TOKLENS_MODEL=gpt-5.6-terra
TOKLENS_BASE_URL=https://lax.toklens.ai/v1

TOKENHUB_API_KEY=
TOKENHUB_MODEL=hy3-preview
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# —— 本地调试 ——
# 设为 1 时用假数据跑通界面，不发真实请求
USE_MOCK=0
# 本地默认 8000；公网平台会注入 PORT
PORT=8000
